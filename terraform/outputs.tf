output "runtime_service_account" {
  value = google_service_account.runtime.email
}

output "deployer_service_account" {
  value = google_service_account.deployer.email
}

output "reports_bucket" {
  value = google_storage_bucket.reports.name
}

output "model_armor_template" {
  value = google_model_armor_template.guardrails.id
}

output "vertex_search_datastore" {
  value = google_discovery_engine_data_store.methodology.name
}

output "github_wif_provider" {
  description = "Set as the GCP_WIF_PROVIDER GitHub variable."
  value       = var.enable_github_wif ? google_iam_workload_identity_pool_provider.github[0].name : null
}

output "mcp_audience" {
  description = "Set as the MCP_AUDIENCE GitHub variable."
  value       = local.mcp_url
}

output "dashboard_url" {
  value = "https://console.cloud.google.com/monitoring/dashboards/builder/${element(split("/", google_monitoring_dashboard.agent.id), 3)}?project=${var.project_id}"
}

# Non-secret application config consumed by deployment/deploy.py and the e2e suite.
resource "local_file" "deploy_env" {
  filename        = "${path.module}/../deployment/environments/${var.project_id}.env"
  file_permission = "0644"
  content         = <<-EOT
    # Generated by Terraform (terraform/outputs.tf). Non-secret: safe to commit.
    GOOGLE_CLOUD_PROJECT=${var.project_id}
    GOOGLE_CLOUD_LOCATION=${var.region}
    AGENT_SERVICE_ACCOUNT=${google_service_account.runtime.email}
    STAGING_BUCKET=gs://${google_storage_bucket.staging.name}
    REPORTS_BUCKET=${google_storage_bucket.reports.name}
    MCP_URL_SECRET_ID=${google_secret_manager_secret.mcp_url.secret_id}
    MODEL_ARMOR_TEMPLATE=${google_model_armor_template.guardrails.id}
    VERTEX_SEARCH_DATASTORE=${google_discovery_engine_data_store.methodology.name}
  EOT
}
