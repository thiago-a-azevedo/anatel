# Copy to .env for local development (`adk web` / `adk run` load it automatically).
# No secrets here: the MCP URL is read from Secret Manager (anatel-mcp-url).
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

MCP_URL_SECRET_ID=anatel-mcp-url
# ANATEL_MCP_URL=            # local override only (never commit a value)
REPORTS_BUCKET=your-project-id-anatel-advisor-reports
MODEL_ARMOR_TEMPLATE=projects/your-project-id/locations/us-central1/templates/anatel-advisor-guardrails
# Agent Search on Gemini Enterprise Agent Platform (formerly Vertex AI Search)
VERTEX_SEARCH_DATASTORE=projects/your-project-id/locations/global/collections/default_collection/dataStores/anatel-methodology-kb

# Model routing
MODEL_ROUTER=gemini-2.5-flash
MODEL_COLLECTOR=gemini-2.5-flash
MODEL_ANALYST=gemini-2.5-pro
MODEL_CRITIC=gemini-2.5-flash

# Observability
PII_REDACTION_MODE=regex     # regex | dlp | off
# true: export OpenTelemetry traces + metrics + logs to Google Cloud Observability from
# this machine (same exporters as `adk web --otel_to_cloud`). On Agent Runtime the
# deploy script enables telemetry via GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY instead.
ENABLE_CLOUD_TRACE=false
# Privacy: prompts / responses / tool args are NOT copied into spans unless you opt in.
# ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
LOG_LEVEL=INFO
